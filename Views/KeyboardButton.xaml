<!-- The keyboard button: one press, always in the same corner.

     Its own window for the same reason the keyboard is — most of the typing in this app
     happens inside a modal dialog, and a button drawn in the window underneath one of those
     cannot be reached. See Floating for why it never takes focus from the box being filled in.

     It has two jobs, and the second one is the reason it animates. It has to be findable,
     which a fixed corner does on its own. And it has to be noticed at the moment it becomes
     useful — the moment the shop taps into a text box — because a button that is always there
     is a button the eye stops seeing. So it wakes up: it lifts to the accent colour and throws
     one ring, once, and then goes quiet again. -->
<Window x:Class="MarketPos.Views.KeyboardButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="104" Height="104"
        UseLayoutRounding="True">

    <Window.Resources>
        <CubicEase x:Key="Ease.Soft" EasingMode="EaseOut"/>
        <BackEase x:Key="Ease.Spring" EasingMode="EaseOut" Amplitude="0.6"/>

        <!-- Arriving. Scaled up from nothing rather than faded in, so it reads as the app
             putting something on the screen rather than as something failing to paint. -->
        <Storyboard x:Key="Arrive">
            <DoubleAnimation Storyboard.TargetName="Whole" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.28"/>
            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX"
                             From="0.4" To="1" Duration="0:0:0.42"
                             EasingFunction="{StaticResource Ease.Spring}"/>
            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY"
                             From="0.4" To="1" Duration="0:0:0.42"
                             EasingFunction="{StaticResource Ease.Spring}"/>
        </Storyboard>

        <!-- Waking, when the shop taps into something it can type in. One ring, thrown outward
             and fading as it goes, and a bounce underneath it. Once — not a loop. A button
             that pulses for ever is a button somebody covers with tape. -->
        <Storyboard x:Key="Wake">
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                             From="0.75" To="1.75" Duration="0:0:0.75"
                             EasingFunction="{StaticResource Ease.Soft}"/>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                             From="0.75" To="1.75" Duration="0:0:0.75"
                             EasingFunction="{StaticResource Ease.Soft}"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ring"
                                           Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame Value="0.55" KeyTime="0:0:0.06"/>
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.75"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX"
                             To="1.12" Duration="0:0:0.18" AutoReverse="True"
                             EasingFunction="{StaticResource Ease.Soft}"/>
            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY"
                             To="1.12" Duration="0:0:0.18" AutoReverse="True"
                             EasingFunction="{StaticResource Ease.Soft}"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="Whole">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Lift" ScaleX="1" ScaleY="1" CenterX="52" CenterY="52"/>
        </Grid.RenderTransform>

        <!-- The ring. Behind the button and hit-test invisible, or it would swallow the press
             it is drawn to attract. -->
        <Ellipse x:Name="Ring" Width="60" Height="60" Opacity="0" IsHitTestVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="RingScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Button x:Name="Tap" Width="60" Height="60" Cursor="Hand" Focusable="False"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Click="Tap_Click" ToolTip="Show the keyboard">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="press" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <Ellipse x:Name="face" Fill="{StaticResource Brush.Panel}"
                                 Stroke="{StaticResource Brush.Border}" StrokeThickness="1">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#1B2126" Opacity="0.22" BlurRadius="16"
                                                  ShadowDepth="3" Direction="270"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <Path x:Name="glyph" Style="{StaticResource Icon}"
                              Data="{StaticResource Icon.Keyboard}" Width="26" Height="26"
                              Fill="{StaticResource Brush.Muted}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="face" Property="Fill"
                                    Value="{StaticResource Brush.AccentSoft}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="press"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.88" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="press"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.88" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="press"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.3"
                                                         EasingFunction="{StaticResource Ease.Spring}"/>
                                        <DoubleAnimation Storyboard.TargetName="press"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.3"
                                                         EasingFunction="{StaticResource Ease.Spring}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Awake: something on screen is waiting to be typed into. -->
                        <DataTrigger Binding="{Binding Awake, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="True">
                            <Setter TargetName="face" Property="Fill"
                                    Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="face" Property="Stroke"
                                    Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="glyph" Property="Fill" Value="White"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
