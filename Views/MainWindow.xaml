<!-- Text is laid out in Ideal mode, not Display. Display uses GDI-compatible metrics
     tuned for the fonts Windows ships with; it snaps an embedded face to whole pixels
     and crops the result, which is why descenders looked cut off. -->
<Window x:Class="MarketPos.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MarketPos.ViewModels"
        xmlns:conv="clr-namespace:MarketPos.Converters"
        xmlns:ctl="clr-namespace:MarketPos.Controls"
        mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Market POS"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{StaticResource Brush.Page}"
        FontFamily="{StaticResource Font.Base}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <conv:MoneyConverter x:Key="Money"/>
        <conv:StringToVisibilityConverter x:Key="StrVis"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolVis"/>
        <conv:InverseStringToVisibilityConverter x:Key="InvStrVis"/>
        <conv:ImagePathConverter x:Key="ProductImage"/>
        <Storyboard x:Key="PaymentConfirmed">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ConfirmOverlay" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.16"/>
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.20"/>
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:1.55"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ConfirmScale" Storyboard.TargetProperty="ScaleX">
                <SplineDoubleKeyFrame Value="0.85" KeyTime="0:0:0"/>
                <SplineDoubleKeyFrame Value="1.0" KeyTime="0:0:0.28" KeySpline="0.2,0.9 0.2,1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ConfirmScale" Storyboard.TargetProperty="ScaleY">
                <SplineDoubleKeyFrame Value="0.85" KeyTime="0:0:0"/>
                <SplineDoubleKeyFrame Value="1.0" KeyTime="0:0:0.28" KeySpline="0.2,0.9 0.2,1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="ProductAdded">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AddedToast" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.18"/>
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.55"/>
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:1.95"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AddedToastSlide" Storyboard.TargetProperty="Y">
                <SplineDoubleKeyFrame Value="18" KeyTime="0:0:0"/>
                <SplineDoubleKeyFrame Value="0" KeyTime="0:0:0.30" KeySpline="0.2,0.9 0.2,1"/>
                <SplineDoubleKeyFrame Value="0" KeyTime="0:0:1.55"/>
                <SplineDoubleKeyFrame Value="10" KeyTime="0:0:1.95" KeySpline="0.4,0,1,1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Window.DataContext>
        <vm:SaleViewModel/>
    </Window.DataContext>

    <!-- No native title bar / close button by design — this runs kiosk-style, maximized.
         Exit is the Logout icon in the rail (Alt+F4 still works as a fallback). -->
    <!-- No DropShadowEffect here on purpose. A blur over a full-screen element is re-rendered
         whenever ANY descendant invalidates, so every button hover was re-blurring ~2 megapixels
         each frame — the single biggest source of stutter. A hairline border sells the same
         elevation against the grey page for free. -->
    <Border Margin="24" CornerRadius="28" Background="{StaticResource Brush.Panel}"
            BorderThickness="1" BorderBrush="#DFE5EA">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Payment confirmation. Purely a signal to the cashier: it fades itself out,
                 never blocks input, and the sale is already saved before it appears. -->
            <Grid x:Name="ConfirmOverlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100"
                  Opacity="0" IsHitTestVisible="False">
                <Border Background="{StaticResource Brush.Panel}" CornerRadius="22" Padding="34,28"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ConfirmScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#1B2126" Opacity="0.22" BlurRadius="34" ShadowDepth="8" Direction="270"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Rounded square, not a circle: it echoes the card radius used
                             everywhere else in the app rather than the stock success badge. -->
                        <Border Width="70" Height="70" CornerRadius="22" Background="{StaticResource Brush.Accent}"
                                HorizontalAlignment="Center" TextElement.Foreground="White">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Check}"
                                  Width="34" Height="34" StrokeThickness="2.4"/>
                        </Border>
                        <TextBlock Text="Payment confirmed" Style="{StaticResource Text.Title}" FontSize="19"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock x:Name="ConfirmDetail" Style="{StaticResource Text.Muted}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== Top bar ===================== -->
            <Grid Grid.Row="0" Margin="32,26,32,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Wordmark is 3.77:1, so Height alone fixes the footprint at ~121x32 -->
                    <Image Source="/Assets/logo.png" Height="32" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Barcode input — the primary input device. Kept focused at all times; see FocusBarcode().
                     Spans the whole row and centers itself so it stays dead-center regardless of what's
                     in the side columns. -->
                <Grid Grid.Column="0" Grid.ColumnSpan="3" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="BarcodeBox"
                             Style="{StaticResource TextBox.Barcode}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="BarcodeBox_LostFocus">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SubmitBarcodeCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <!-- 22 is the measured text origin of the box (18px content-host inset +
                         border + the TextBox's own internal offset). Placeholder, typed text
                         and caret therefore all start on exactly the same pixel. -->
                    <TextBlock Text="Search"
                               FontSize="14" Margin="22,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource Brush.Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=BarcodeBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Small and quiet: this is a hint that the box searches, not a control.
                         The box itself is the affordance. -->
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Search}"
                          Width="13" Height="13" StrokeThickness="1.7" IsHitTestVisible="False"
                          HorizontalAlignment="Right" Margin="0,0,16,0"
                          TextElement.Foreground="{StaticResource Brush.Muted}"/>
                </Grid>

                <!-- No notifications/help/Support here — this is a till. Just window controls
                     (custom, since the window has no native title bar): minimize to hide, ✕ to close. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The link to the back office. Invisible on a shop with one computer;
                         on a second till it is the one thing a cashier needs to be able to
                         glance at, because it is the difference between "the shop knows about
                         this sale" and "the shop will know when the other machine wakes up". -->
                    <Button x:Name="LinkChip" Style="{StaticResource Button.PillMuted}"
                            Height="34" Margin="0,0,10,0" Visibility="Collapsed"
                            Click="LinkChip_Click"
                            ToolTip="Press to send now">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LinkDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{StaticResource Brush.Muted}"/>
                            <TextBlock x:Name="LinkStatus" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Price check. Green while it is on, because the one thing that must
                         never happen is a cashier believing they are selling while every scan
                         is only being looked up - or the reverse. -->
                    <ToggleButton Style="{StaticResource Button.TogglePill}" Height="34"
                                  FontSize="12.5" Margin="0,0,14,0"
                                  IsChecked="{Binding IsPriceCheck, Mode=TwoWay}"
                                  ToolTip="Scan an item to see its price without selling it">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Search}"
                                  Width="13" Height="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Price check" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button Style="{StaticResource Button.WinControl}" ToolTip="Minimize" Click="Minimize_Click">
                        <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Minimize}"/>
                    </Button>
                    <Button Style="{StaticResource Button.Close}" ToolTip="Close" Click="Close_Click" Margin="4,0,0,0">
                        <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Close}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================== Body ===================== -->
            <!-- ClipToBounds contains the cart panel while it is translated off to the right -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Auto, so the cart column takes no room at all while the cart is empty -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!-- Toolbar (held tickets + sort) sits in its own row so it pushes only the
                         product grid down, never the rail beside it. -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Left icon rail, spanning both rows.
                     
                     It used to sit in the row below the toolbar, so the toolbar's height moved
                     it: the toolbar only shows on the Sale page, so switching to Products made
                     every rail icon jump up thirty pixels. Navigation is furniture - it is how
                     you know where you are, and it has to be in the same place on every page.
                     Spanning both rows anchors it to the window instead of to whatever the
                     current page happens to put above it. -->
                <DockPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" LastChildFill="False"
                           Margin="0,-10,0,20">
                    <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                        <RadioButton x:Name="RailSale" Style="{StaticResource Button.Rail}" GroupName="rail" ToolTip="Sale"
                                     IsChecked="{Binding IsSalePage, Mode=OneWay}" Checked="Nav_Sale">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Cart}"/>
                        </RadioButton>
                        <RadioButton x:Name="RailProducts" Style="{StaticResource Button.Rail}" GroupName="rail" ToolTip="Products"
                                     IsChecked="{Binding IsProductsPage, Mode=OneWay}" Checked="Nav_Products">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Bag}"/>
                        </RadioButton>
                        <RadioButton x:Name="RailTickets" Style="{StaticResource Button.Rail}" GroupName="rail" ToolTip="Tickets"
                                     IsChecked="{Binding IsTicketsPage, Mode=OneWay}" Checked="Nav_Tickets">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Receipt}"/>
                        </RadioButton>

                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                        <!-- Opens the back office in its own window rather than switching page, so the
                             till stays a single-purpose screen a cashier cannot get lost in. -->
                        <RadioButton x:Name="RailAdmin" Style="{StaticResource Button.Rail}" GroupName="rail"
                                     ToolTip="Back office" Checked="Nav_Admin">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Lock}"/>
                        </RadioButton>
                        <Button x:Name="SignOutButton" Style="{StaticResource Button.Circle}"
                                ToolTip="Close the till" Click="Logout_Click" Margin="0,10">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Power}" Width="19" Height="19"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Center toolbar: price check + held tickets + sort/filter row -->
                <Grid Grid.Row="0" Grid.Column="1" Margin="8,10,20,0"
                      Visibility="{Binding IsSalePage, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- status banner -->
                        <RowDefinition Height="Auto"/>   <!-- held tickets -->
                        <RowDefinition Height="Auto"/>   <!-- sort / filter -->
                    </Grid.RowDefinitions>

                    <!-- Status banner. Lives here, NOT in the cart sidebar: that panel is collapsed
                         whenever the cart is empty, which is exactly when search feedback and the
                         "Sale #N completed" confirmation need to be seen. -->
                    <Border Grid.Row="0" CornerRadius="12" Padding="14,10" Margin="0,0,0,14"
                            Visibility="{Binding StatusMessage, Converter={StaticResource StrVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Parked sales. Lives out here rather than in the cart sidebar, because the
                         sidebar is gone while the cart is empty — which is exactly when the
                         cashier needs to pick a held ticket back up. -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,18"
                                Visibility="{Binding HasHeldTickets, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Pause}"
                                  Width="13" Height="13" StrokeThickness="2"
                                  TextElement.Foreground="{StaticResource Brush.Muted}"/>
                            <TextBlock Text="ON HOLD" Style="{StaticResource Text.Eyebrow}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding HeldTickets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.Card}" CornerRadius="13"
                                            Margin="0,0,10,10" ToolTip="{Binding HeldAtLabel}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Button.TicketChip}"
                                                    Command="{Binding DataContext.ResumeTicketCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}"
                                                               FontSize="11" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Button.Round}" Width="26" Height="26"
                                                    Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource Brush.Muted}"
                                                    ToolTip="Discard this ticket"
                                                    Command="{Binding DataContext.DiscardTicketCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Close}"
                                                      Width="11" Height="11" StrokeThickness="2.2"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource Button.PillMuted}"
                                VerticalAlignment="Center" FontSize="13" Padding="16,9"
                                ToolTip="Print another copy of a past receipt"
                                Click="Reprint_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Receipt}"
                                      Width="14" Height="14"/>
                                <TextBlock Text="Reprint receipt" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </Grid>
                </Grid>

                <!-- Nothing matched the current filter. Without this the grid just goes blank,
                     which reads as the app breaking rather than as a search with no results. -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,20,20"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsSaleEmptyVisible, Converter={StaticResource BoolVis}}">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Search}"
                          Width="34" Height="34" StrokeThickness="1.4"
                          TextElement.Foreground="{StaticResource Brush.Muted}"/>
                    <TextBlock x:Name="EmptyTitle" Text="No products found"
                               Style="{StaticResource Text.Title}" FontSize="16"
                               Foreground="{StaticResource Brush.Muted}"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock x:Name="EmptyBody" Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" TextAlignment="Center" MaxWidth="300" TextWrapping="Wrap"
                               Text="Nothing here matches what you typed, or the category filter is hiding it."/>
                    <Button x:Name="ClearSearchButton" Style="{StaticResource Button.PillMuted}"
                            Content="Clear search"
                            HorizontalAlignment="Center" Margin="0,18,0,0"
                            Command="{Binding ClearSearchCommand}"/>
                </StackPanel>

                <!-- Product grid — row 1, so its top edge is the same as the rail's -->
                <ScrollViewer x:Name="ProductScroll" Grid.Row="1" Grid.Column="1" Margin="8,0,20,20"
                              VerticalScrollBarVisibility="Hidden"
                              Visibility="{Binding IsSaleGridVisible, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding ProductsView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctl:ProductGridPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.ProductCard}"
                                            Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <!-- Every row is a fixed height so the image, name, category and price
                                             land on the same baseline in every card. A one-line name still
                                             reserves two lines, otherwise a wrapping name like "Laundry Powder
                                             3kg" shunts its category and price out of alignment with its
                                             neighbours. The * row lets the price sit flush to the bottom. -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <!-- The photo takes every spare pixel, so a taller tile means a
                                                     bigger product shot rather than more dead space. The text
                                                     block below stays a fixed height so names, categories and
                                                     prices line up across every card. -->
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="42"/>
                                                <RowDefinition Height="16"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Product image, when the shop has one. -->
                                            <Grid Grid.Row="0">
                                                <!-- One consistent branded tile behind every product. The photo
                                                     sits ON it and never covers it. A product with no photo shows
                                                     the tile and its name, which is honest — a stand-in glyph on
                                                     every card made the whole grid look like a mock-up. -->
                                                <Border CornerRadius="14" Background="{StaticResource Brush.ImageTile}"/>

                                                <!-- Real product photo. Stretch="Uniform" is object-fit: contain —
                                                     never cropped, never distorted. Margin 9 on an 86px box leaves
                                                     the image ~80% of the area, centred, with the pastel showing
                                                     around it. No background brush, so alpha PNGs stay transparent. -->
                                                <Image Source="{Binding ImagePath, Converter={StaticResource ProductImage}}"
                                                       Stretch="Uniform" Margin="8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding ImagePath, Converter={StaticResource StrVis}}"/>
                                            </Grid>

                                            <!-- Height 32 = exactly two 16px lines; ClipToBounds keeps a very long
                                                 product name from spilling into the price row. -->
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="2,9,0,0"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                                       Height="32" ClipToBounds="True"
                                                       VerticalAlignment="Top"/>

                                            <TextBlock Grid.Row="2" Text="{Binding Category}" Margin="2,0,0,0"
                                                       Style="{StaticResource Text.Muted}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Top"/>

                                            <TextBlock Grid.Row="3" Text="{Binding PriceLabel}" Margin="2,0,0,0"
                                                       Foreground="{StaticResource Brush.Accent}"
                                                       FontWeight="SemiBold" FontSize="14"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </ScrollViewer>

                <!-- ===================== Products page ===================== -->
                <!-- Margin top 0 so the heading shares a baseline with the first rail icon,
                     which carries a -10 offset of its own. -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,20,20"
                      Visibility="{Binding IsProductsPage, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header swaps between the category list and a drilled-into category -->
                    <Grid Grid.Row="0" Margin="2,0,0,18">
                        <StackPanel Visibility="{Binding IsCategoryListVisible, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Products" Style="{StaticResource Text.Title}"/>
                            <TextBlock Text="Pick a category to see what is in it."
                                       Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsCategoryOpen, Converter={StaticResource BoolVis}}">
                            <Button Style="{StaticResource Button.Round}" Width="38" Height="38"
                                    VerticalAlignment="Center" Margin="0,0,14,0"
                                    ToolTip="Back to categories" Click="CategoryBack_Click">
                                <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Back}"
                                      Width="16" Height="16"/>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding OpenCategory}" Style="{StaticResource Text.Title}"/>
                                <TextBlock Text="Products in this category"
                                           Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Category tiles: picture and name only -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                  Visibility="{Binding IsCategoryListVisible, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding CategorySummaries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- No overrides: same tile size as the Sale and product grids,
                                         so every card in the app is the same object. -->
                                    <ctl:ProductGridPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.ProductCard}"
                                            Tag="{Binding Name}" Click="Category_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Border CornerRadius="14" Background="{StaticResource Brush.ImageTile}"/>
                                                <Image Source="{Binding ImagePath, Converter={StaticResource ProductImage}}"
                                                       Stretch="Uniform" Margin="8"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="2,10,0,0"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Products inside the opened category -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                  Visibility="{Binding IsCategoryOpen, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding CategoryProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- No overrides: identical sizing to the Sale page grid, so a
                                         product card is the same object wherever the cashier meets it. -->
                                    <ctl:ProductGridPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.ProductCard}"
                                            Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="42"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Border CornerRadius="14" Background="{StaticResource Brush.ImageTile}"/>
                                                <Image Source="{Binding ImagePath, Converter={StaticResource ProductImage}}"
                                                       Stretch="Uniform" Margin="8"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="2,9,0,0"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text}"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                                       Height="32" ClipToBounds="True" VerticalAlignment="Top"/>

                                            <TextBlock Grid.Row="2" Text="{Binding PriceLabel}" Margin="2,0,0,0"
                                                       Foreground="{StaticResource Brush.Accent}"
                                                       FontWeight="SemiBold" FontSize="14"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ===================== Tickets page ===================== -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,20,20"
                      Visibility="{Binding IsTicketsPage, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="2,0,0,14">
                        <TextBlock Text="Tickets" Style="{StaticResource Text.Title}"/>
                        <TextBlock Text="{Binding TicketsHeadline}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Margin="2,0,0,12" Style="{StaticResource Text.Muted}"
                               Text="Type a receipt number in the search bar above, or pick a ticket to view and reprint it."/>

                    <Grid Grid.Row="2">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasTickets, Converter={StaticResource InvBoolVis}}">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Receipt}"
                                  Width="34" Height="34" StrokeThickness="1.4"
                                  TextElement.Foreground="{StaticResource Brush.Muted}"/>
                            <TextBlock Text="No tickets yet" Style="{StaticResource Text.Title}" FontSize="16"
                                       Foreground="{StaticResource Brush.Muted}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" TextAlignment="Center" MaxWidth="330" TextWrapping="Wrap"
                                       Text="Completed sales appear here. Finish a sale with Pay and its ticket lands in this list."/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      Visibility="{Binding HasTickets, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{Binding Tickets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Button.TicketRow}" Click="Ticket_Click"
                                                Tag="{Binding InvoiceNumber}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Number}" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" FontSize="15"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding When}" FontSize="13"/>
                                                    <TextBlock Text="{Binding DiscountLabel}" FontSize="11" Margin="0,2,0,0"
                                                               Foreground="{StaticResource Brush.Danger}"
                                                               Visibility="{Binding HasDiscount, Converter={StaticResource BoolVis}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ItemsLabel}" VerticalAlignment="Center"
                                                           Style="{StaticResource Text.Muted}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding MethodLabel}" VerticalAlignment="Center"
                                                           Style="{StaticResource Text.Muted}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding TotalLabel}" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" FontSize="15"
                                                           Foreground="{StaticResource Brush.Accent}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ===================== The price check answer =====================
                     Sits over the product grid rather than in the cart column: the cart is
                     what the customer is buying, and this is deliberately not part of it.
                     Nothing here writes anything; the card is replaced by the next scan. -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2"
                      Panel.ZIndex="95" Margin="8,0,20,20"
                      Visibility="{Binding HasPriceCheckResult, Converter={StaticResource BoolVis}}">

                    <!-- A wash over the shelf behind it, so the answer is the only thing being
                         read. Not a full scrim: the cashier still needs to see the till is the
                         till. -->
                    <Border Background="#F2FFFFFF" CornerRadius="20"/>

                    <Border Width="470" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="{StaticResource Brush.Panel}" CornerRadius="22"
                            BorderThickness="1" BorderBrush="{StaticResource Brush.Border}"
                            Padding="30,26">
                        <Border.Effect>
                            <DropShadowEffect Color="#1B2126" Opacity="0.14" BlurRadius="34"
                                              ShadowDepth="8" Direction="270"/>
                        </Border.Effect>

                        <StackPanel DataContext="{Binding PriceCheckResult}">
                            <Grid Margin="0,0,0,18">
                                <TextBlock Text="PRICE CHECK" Style="{StaticResource Text.Eyebrow}"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource Button.Circle}" Width="28" Height="28"
                                        HorizontalAlignment="Right" ToolTip="Close"
                                        Click="ClosePriceCheck_Click">
                                    <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Close}"
                                          Width="12" Height="12"/>
                                </Button>
                            </Grid>

                            <!-- Found -->
                            <StackPanel Visibility="{Binding Found, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                           FontFamily="{StaticResource Font.Brand}" FontWeight="Bold"
                                           FontSize="23" Foreground="{StaticResource Brush.Text}"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}"
                                           FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding PriceText}" Margin="0,20,0,0"
                                           FontFamily="{StaticResource Font.Brand}" FontWeight="Bold"
                                           FontSize="42" Foreground="{StaticResource Brush.Accent}"
                                           Typography.NumeralAlignment="Tabular"
                                           Typography.NumeralStyle="Lining"/>

                                <TextBlock Text="{Binding StockText}" Style="{StaticResource Text.Muted}"
                                           Margin="0,8,0,0"/>

                                <!-- Owner only. A cashier who can read the purchase price of
                                     every product on the shelf knows the shop's margins. -->
                                <StackPanel Margin="0,18,0,0"
                                            Visibility="{Binding ShowsCost, Converter={StaticResource BoolVis}}">
                                    <Border Style="{StaticResource Rule}" Margin="0,0,0,14"/>
                                    <TextBlock Text="{Binding CostText}" Style="{StaticResource Text.Muted}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Not found -->
                            <StackPanel Visibility="{Binding Found, Converter={StaticResource InvBoolVis}}">
                                <TextBlock Text="{Binding Query}" TextWrapping="Wrap"
                                           FontFamily="{StaticResource Font.Brand}" FontWeight="Bold"
                                           FontSize="21" Foreground="{StaticResource Brush.Text}"/>
                                <TextBlock Text="{Binding MissText}" Style="{StaticResource Text.Muted}"
                                           Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Text="Scan the next item, or press Esc to go back to selling"
                                       Style="{StaticResource Text.Muted}" FontSize="11.5"
                                       Margin="0,22,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- "Added to sale" toast. The cart sidebar only exists on the Sale page, so
                     adding an item while browsing categories gave the cashier no feedback at
                     all. Never blocks input; fades itself out. -->
                <Border x:Name="AddedToast" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2"
                        Panel.ZIndex="90" Opacity="0" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="8,0,0,22" Padding="14,12"
                        Background="{StaticResource Brush.Panel}" CornerRadius="16"
                        BorderThickness="1" BorderBrush="{StaticResource Brush.Border}"
                        RenderTransformOrigin="0,1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="AddedToastSlide" Y="18"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#1B2126" Opacity="0.16" BlurRadius="26" ShadowDepth="6" Direction="270"/>
                    </Border.Effect>

                    <StackPanel Orientation="Horizontal">
                        <Grid Width="42" Height="42" Margin="0,0,14,0">
                            <Border CornerRadius="11" Background="{StaticResource Brush.ImageTile}"/>
                            <Image x:Name="AddedToastImage" Stretch="Uniform" Margin="5"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>

                        <StackPanel VerticalAlignment="Center" MinWidth="150">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Check}"
                                      Width="12" Height="12" StrokeThickness="2.4"
                                      TextElement.Foreground="{StaticResource Brush.Accent}"/>
                                <TextBlock x:Name="AddedToastTitle" Margin="7,0,0,0" VerticalAlignment="Center"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            </StackPanel>
                            <TextBlock x:Name="AddedToastSubtitle" Style="{StaticResource Text.Muted}"
                                       FontSize="12" Margin="19,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right: cart sidebar. Hidden entirely until the first item is added — an empty
                     panel of zeroes tells the cashier nothing.

                     Slides via RenderTransform, never Width. Animating Width is a layout
                     property: every frame re-measured the whole body, including all 23
                     product cards and their text — which is what made this stutter. A
                     transform runs on the render thread and touches no layout at all. -->
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                        Background="{StaticResource Brush.Card}" CornerRadius="20"
                        Margin="0,10,20,20" Padding="20" Width="0" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCartPanelOpen}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                                 Duration="0:0:0.20" EasingFunction="{StaticResource Ease.Out}"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="350"
                                                                 Duration="0:0:0.30" EasingFunction="{StaticResource Ease.Out}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                                 Duration="0:0:0.18" EasingFunction="{StaticResource Ease.Out}"/>
                                                <!-- Width, not a transform: the product grid has to actually
                                                     grow into the space as the panel closes. -->
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="0"
                                                                 Duration="0:0:0.28" EasingFunction="{StaticResource Ease.Out}"/>
                                                <!-- Collapse only once the slide-out has finished, or the
                                                     panel would vanish before the animation is seen. -->
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.28" Value="{x:Static Visibility.Collapsed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid Width="310" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ItemCountLabel}" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Text="Current Sale" Style="{StaticResource Text.Title}" FontSize="16" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Avatar.Circle}"
                                    TextElement.Foreground="{StaticResource Brush.Accent}">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.User}" Width="19" Height="19"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <ItemsControl x:Name="CartList" ItemsSource="{Binding Cart}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Pulses green for a moment when this line is scanned,
                                                 so a successful scan is visible as well as audible. -->
                                            <StackPanel Margin="0,0,0,14">
                                                <StackPanel.Background>
                                                    <SolidColorBrush x:Name="flash" Color="#12B76A" Opacity="0"/>
                                                </StackPanel.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Same tile as the grid card, thumbnail-sized -->
                                                    <Grid Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0">
                                                        <Border CornerRadius="9" Background="{StaticResource Brush.ImageTile}"/>
                                                        <Image Source="{Binding Product.ImagePath, Converter={StaticResource ProductImage}}"
                                                               Stretch="Uniform" Margin="4"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding Product.ImagePath, Converter={StaticResource StrVis}}"/>
                                                    </Grid>

                                                    <TextBlock Grid.Column="1" Text="{Binding Product.Name}" VerticalAlignment="Center"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="2" Style="{StaticResource Button.Round}"
                                                            Width="26" Height="26"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource Brush.Muted}"
                                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Close}"
                                                              Width="11" Height="11" StrokeThickness="2.2"/>
                                                    </Button>
                                                </Grid>

                                                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Round}"
                                                            Command="{Binding DataContext.DecrementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Minus}" Width="13" Height="13"/>
                                                    </Button>
                                                    <!-- Type the quantity directly — essential for weighed goods,
                                                         where stepping to 1.35 kg would be 13 taps. -->
                                                    <TextBox DockPanel.Dock="Left"
                                                             Style="{StaticResource TextBox.Quantity}"
                                                             Text="{Binding QuantityText, UpdateSourceTrigger=LostFocus}"
                                                             GotFocus="QuantityBox_GotFocus"
                                                             PreviewTextInput="QuantityBox_PreviewTextInput"
                                                             KeyDown="QuantityBox_KeyDown"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding UnitSuffix}"
                                                               Style="{StaticResource Text.Muted}"
                                                               Width="20" Margin="1,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Round}"
                                                            Command="{Binding DataContext.IncrementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Plus}" Width="13" Height="13"/>
                                                    </Button>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LineTotal, Converter={StaticResource Money}}"
                                                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,14,0,0"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="flash"
                                                                                               Storyboard.TargetProperty="Opacity">
                                                                    <LinearDoubleKeyFrame Value="0.18" KeyTime="0:0:0.06"/>
                                                                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.55"/>
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,16,0,0">
                            <Grid Margin="0,0,0,4"
                                  Visibility="{Binding HasDiscount, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Subtotal" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding GrossBeforeDiscount, Converter={StaticResource Money}}" Style="{StaticResource Text.Body}"/>
                            </Grid>

                            <!-- Remise line, only present once a discount is actually given -->
                            <Grid Margin="0,0,0,4" Visibility="{Binding HasDiscount, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DiscountLabel}" Style="{StaticResource Text.Muted}"
                                           Foreground="{StaticResource Brush.Danger}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"
                                           Foreground="{StaticResource Brush.Danger}">
                                    <Run Text="-"/><Run Text="{Binding DiscountAmount, Converter={StaticResource Money}, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,6,0,10"/>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Total" Style="{StaticResource Text.Title}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Total, Converter={StaticResource Money}}"
                                           Style="{StaticResource Text.Title}" Foreground="{StaticResource Brush.Accent}"/>
                            </Grid>

                            <!-- Give a regular customer a discount -->
                            <Button Style="{StaticResource Button.PillMuted}" Margin="0,0,0,10"
                                    IsEnabled="{Binding HasItems}" Click="Discount_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Minus}"
                                          Width="13" Height="13"/>
                                    <TextBlock Text="Remise" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Park this sale and start a fresh cart for the next customer -->
                            <Button Style="{StaticResource Button.PillMuted}" Margin="0,0,0,10"
                                    Command="{Binding HoldSaleCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Pause}"
                                          Width="13" Height="13"/>
                                    <TextBlock Text="Hold ticket" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource Button.PillMuted}" Content="Cancel"
                                        IsEnabled="{Binding HasItems}" Click="CancelSale_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource Button.Pill}" Content="Pay"
                                        FontSize="16" Padding="22,14"
                                        Command="{Binding PayCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
