<!-- Settings holds one thing: the language.

     It used to carry the shop's name, phone, address, currency, receipt footer, printer,
     auto-print and the back-office address. Those are set once when the shop is installed and
     never touched again, and every one of them was a way for an owner to break their own
     receipts by pressing something on a screen they opened to change the language. They keep
     whatever they are set to; nothing is lost, it just is not editable from here.

     Written in English, which is the source text every translation is keyed by — see
     Translations. This window was written in Arabic literals, which is why it stayed Arabic in
     French: there was nothing for the translator to look the words up by. -->
<Window x:Class="MarketPos.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.25" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource Text.Title}" FontSize="20"/>
            <TextBlock Text="The language the app speaks" Style="{StaticResource Text.Muted}"
                       Margin="0,4,0,18"/>

            <TextBlock Text="LANGUAGE" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,8"/>
            <ComboBox x:Name="LanguageBox" Style="{StaticResource ComboBox.Field}"/>
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="2,8,2,0"
                       TextWrapping="Wrap"
                       Text="The whole app, in your language. It changes when the app is restarted."/>

            <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,18,0,16"/>

            <TextBlock Text="RECEIPT PRINTER" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,8"/>
            <ComboBox x:Name="PrinterBox" Style="{StaticResource ComboBox.Field}"/>
            <TextBlock x:Name="PrinterHint" Style="{StaticResource Text.Muted}" FontSize="11" Margin="2,6,2,0"
                       TextWrapping="Wrap" Text="Receipts will print automatically to this printer."/>

            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource Button.PillMuted}" Content="Test print"
                        VerticalAlignment="Center" Click="TestPrint_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.PillMuted}" Content="Cancel" Click="Cancel_Click"/>
                    <Button Style="{StaticResource Button.Pill}" Content="Save" Margin="10,0,0,0"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
