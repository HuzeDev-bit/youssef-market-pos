<Window x:Class="MarketPos.Views.Admin.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product" Width="720" SizeToContent="Height"
        MaxHeight="880"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Base}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="22" Background="{StaticResource Brush.Panel}" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.22" BlurRadius="34" ShadowDepth="10" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Title}"/>
                    <TextBlock x:Name="SubText" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource Button.RowAction}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Cancel_Click">
                    <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Close}"/>
                </Button>
            </Grid>

            <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Identity, with the picture beside it.
                         The photo earns its place on exactly the products that get a tile at
                         the till — bread, produce, anything with no barcode to scan — because
                         a picture is what the cashier presses. -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource Button.Card}"
                                Width="94" Height="94" Padding="0" Click="Picture_Click"
                                VerticalAlignment="Top"
                                ToolTip="Choose a photo for this product">
                            <Grid>
                                <Border CornerRadius="12" Background="{StaticResource Brush.ImageTile}"/>
                                <Image x:Name="PictureBox" Stretch="UniformToFill" Margin="3"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,88,88" RadiusX="10" RadiusY="10"/>
                                    </Image.Clip>
                                </Image>
                                <StackPanel x:Name="PicturePrompt" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Box}"
                                          Width="20" Height="20" Fill="{StaticResource Brush.Muted}"/>
                                    <TextBlock Text="Photo" Style="{StaticResource Text.Eyebrow}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PRODUCT NAME" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Field}"/>
                            <TextBlock x:Name="PictureNote" Style="{StaticResource Text.Muted}"
                                       FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="الفئة" Style="{StaticResource Text.FieldLabel}"/>
                            <ComboBox x:Name="CategoryBox" Style="{StaticResource ComboBox.Form}"
                                      IsEditable="True"/>
                            <Button x:Name="RemovePicture" Style="{StaticResource Button.SmallMuted}"
                                    Content="Remove photo" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Visibility="Collapsed"
                                    Click="RemovePicture_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="الباركود" Style="{StaticResource Text.FieldLabel}" Margin="2,0,0,0"/>
                                <TextBlock Text="Generate" Style="{StaticResource Text.Eyebrow}"
                                           Foreground="{StaticResource Brush.Accent}"
                                           HorizontalAlignment="Right" Cursor="Hand"
                                           MouseLeftButtonDown="GenerateBarcode_Click"
                                           ToolTip="Make an in-store code for a product with no printed barcode"/>
                            </Grid>
                            <TextBox x:Name="BarcodeBox" Style="{StaticResource TextBox.Field}"
                                     TextChanged="Barcode_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SKU / INTERNAL CODE" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox x:Name="SkuBox" Style="{StaticResource TextBox.Field}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SOLD BY" Style="{StaticResource Text.FieldLabel}"/>
                            <ComboBox x:Name="UnitBox" Style="{StaticResource ComboBox.Form}"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Rule}" Margin="0,6,0,16"/>

                    <!-- Money -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PURCHASE PRICE (COST)" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox x:Name="CostBox" Style="{StaticResource TextBox.Field}"
                                     TextChanged="Money_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SELLING PRICE" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox x:Name="PriceBox" Style="{StaticResource TextBox.Field}"
                                     TextChanged="Money_Changed"/>
                        </StackPanel>
                        <!-- VAT is for a shop that is registered for it. Shown only when the
                             shop has a tax id in Settings; a corner shop that has none was
                             being asked to pick a bracket it does not owe. -->
                        <StackPanel x:Name="TaxField" Grid.Column="4">
                            <TextBlock Text="VAT" Style="{StaticResource Text.FieldLabel}"/>
                            <ComboBox x:Name="TaxBox" Style="{StaticResource ComboBox.Form}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="MARGIN" Style="{StaticResource Text.FieldLabel}"/>
                            <Border Style="{StaticResource Card.Inner}" Height="40" Padding="12,0">
                                <TextBlock x:Name="MarginText" Style="{StaticResource Text.Cell}"
                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="MarginWarning" Style="{StaticResource Text.Muted}"
                               Foreground="{StaticResource Brush.Danger}" Margin="2,0,0,0"
                               Visibility="Collapsed"
                               Text="The selling price is below the cost — every sale of this product loses money."/>

                    <Border Style="{StaticResource Rule}" Margin="0,16,0,16"/>

                    <!-- Stock -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="StockLabel" Text="OPENING STOCK"
                                       Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox x:Name="StockBox" Style="{StaticResource TextBox.Field}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MINIMUM STOCK" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox x:Name="MinStockBox" Style="{StaticResource TextBox.Field}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SHELF / LOCATION" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox x:Name="ShelfBox" Style="{StaticResource TextBox.Field}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="EXPIRES ON" Style="{StaticResource Text.FieldLabel}"/>
                            <DatePicker x:Name="ExpiryBox" Style="{StaticResource DatePicker.Field}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="SUPPLIER" Style="{StaticResource Text.FieldLabel}"/>
                            <ComboBox x:Name="SupplierBox" Style="{StaticResource ComboBox.Form}"
                                      ItemTemplate="{StaticResource Combo.Name}"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Card.Inner}" Margin="0,4,0,0">
                        <StackPanel>
                            <CheckBox x:Name="ShowInPosBox" Style="{StaticResource Check.Field}"
                                      Content="Sold at the till"/>
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="29,4,0,0" TextWrapping="Wrap"
                                       Text="A product with a printed barcode is scanned. One without gets a tile the cashier presses, which is where its photo shows. Turn this off for something the shop records but never sells over the counter."/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Body}" FontSize="12.5"
                               Foreground="{StaticResource Brush.Danger}" Margin="2,14,2,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding Text, RelativeSource={RelativeSource Self},
                                            Converter={StaticResource StrVis}}"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Margin="0,22,0,0">
                <Button Style="{StaticResource Button.PillMuted}" Content="إلغاء"
                        HorizontalAlignment="Left" Width="120" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Style="{StaticResource Button.Pill}" Content="Save product"
                        HorizontalAlignment="Right" Width="170" Click="Save_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
