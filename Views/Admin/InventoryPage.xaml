<local:AdminPageBase x:Class="MarketPos.Views.Admin.InventoryPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:MarketPos.Views.Admin">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== Search and filters ====================
             Controls on one line, and the sentence describing what they produced on the
             next. The summary used to share the line with the search box and was the first
             thing squeezed out of existence when anything else was added to it. -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Brush.Card}" CornerRadius="10" Height="36">
                <Grid>
                    <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Search}"
                          Width="13" Height="13" HorizontalAlignment="Left" Margin="13,0,0,0"
                          Stroke="{StaticResource Brush.Muted}"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Plain}" Height="36"
                             Background="Transparent" BorderThickness="0" Margin="33,0,10,0"
                             VerticalContentAlignment="Center" FontSize="13"
                             CaretBrush="{StaticResource Brush.Text}" TextChanged="Filter_Changed"/>
                    <TextBlock Text="Product name or barcode" Style="{StaticResource Text.Muted}"
                               Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox,
                                            Converter={StaticResource InvStrVis}}"/>
                </Grid>
            </Border>

            <!-- Only the categories the shop actually made, plus a way back out of the filter. -->
            <ComboBox x:Name="CategoryFilter" Grid.Column="1" Style="{StaticResource ComboBox.Form}"
                      Width="170" Height="36" Margin="10,0,0,0"
                      ItemTemplate="{StaticResource Combo.Name}" SelectionChanged="Filter_Changed"/>

            <!-- The range reads the expiry date, not the date the product was added: on a
                 stocktake the question is always what goes off between now and then. -->
            <TextBlock Grid.Column="2" Text="EXPIRES BETWEEN" Style="{StaticResource Text.Eyebrow}"
                       VerticalAlignment="Center" Margin="16,0,10,0"/>

            <DatePicker x:Name="FromDate" Grid.Column="3" Style="{StaticResource DatePicker.Field}"
                        Width="146" Height="36" SelectedDateChanged="Dates_Changed"/>

            <!-- An empty date box is a blank rectangle with a calendar on it, and says
                 nothing about which end of the range it is. The hint steps aside the
                 moment a date is picked. -->
            <TextBlock Grid.Column="3" Text="Start date" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       Style="{StaticResource Hint.Date}"
                       Tag="{Binding SelectedDate, ElementName=FromDate}"/>

            <TextBlock Grid.Column="4" Text="&#x2014;" Style="{StaticResource Text.Muted}"
                       VerticalAlignment="Center" Margin="8,0,8,0"/>

            <DatePicker x:Name="ToDate" Grid.Column="5" Style="{StaticResource DatePicker.Field}"
                        Width="146" Height="36" SelectedDateChanged="Dates_Changed"/>

            <TextBlock Grid.Column="5" Text="End date" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       Style="{StaticResource Hint.Date}"
                       Tag="{Binding SelectedDate, ElementName=ToDate}"/>

            <Button x:Name="ClearFilters" Grid.Column="6" Style="{StaticResource Button.SmallMuted}"
                    Height="36" Margin="10,0,0,0" HorizontalAlignment="Left"
                    Content="Clear filters" Click="Clear_Click" Visibility="Collapsed"/>

            <!-- A removed product is not deleted, so there has to be somewhere to see it and
                 a way back. Without this, taking something off the shelf is one-way and the
                 owner's only recourse is to type the whole product in again. -->
            <CheckBox x:Name="ShowRemoved" Grid.Column="6" Style="{StaticResource Check.Field}"
                      Content="Show removed" VerticalAlignment="Center"
                      HorizontalAlignment="Right" Margin="10,0,0,0" Click="Filter_Changed"/>

            <TextBlock x:Name="Summary" Grid.Row="1" Grid.ColumnSpan="7"
                       Style="{StaticResource Text.Muted}" Margin="2,10,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- ==================== The products ==================== -->
        <Border Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource Brush.Card}"
                CornerRadius="16" Padding="10,14,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="78"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PRODUCT" Style="{StaticResource Text.ColumnHead}"/>
                    <TextBlock Grid.Column="1" Text="EXPIRES" Style="{StaticResource Text.ColumnHead}"/>
                    <TextBlock Grid.Column="2" Text="QUANTITY" Style="{StaticResource Text.ColumnHead}"
                               TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="COST EACH" Style="{StaticResource Text.ColumnHead}"
                               TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text=""/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Rule}" Margin="12,0,12,4"
                        Background="{StaticResource Brush.Panel}"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="Rows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="row" Style="{StaticResource Button.Row}" Padding="12,0"
                                            Click="Row_Click" Tag="{Binding Id}"
                                            ToolTip="Adjust or count this stock">
                                        <Grid Height="38">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="78"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Style="{StaticResource Text.Cell}"
                                                           FontWeight="SemiBold" Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Says which of the two lists you are looking
                                                     at. A removed product only appears at all
                                                     when Show removed is on, and then it has to
                                                     be obvious which rows those are. -->
                                                <Border x:Name="removedTag" Grid.Column="1"
                                                        Style="{StaticResource Badge.Neutral}"
                                                        Margin="10,0,0,0" Visibility="Collapsed">
                                                    <TextBlock Text="Removed"/>
                                                </Border>
                                            </Grid>

                                            <!-- Quiet until the week it matters, then the one
                                                 thing on the row worth reading. -->
                                            <TextBlock x:Name="expiry" Grid.Column="1"
                                                       Style="{StaticResource Text.CellMuted}"
                                                       Text="{Binding ExpiryLabel}"/>

                                            <TextBlock x:Name="onHand" Grid.Column="2"
                                                       Style="{StaticResource Text.Money}"
                                                       Text="{Binding StockLabel}"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource Text.Money}"
                                                       FontWeight="Normal"
                                                       Text="{Binding Cost, Converter={StaticResource Money}}"/>

                                            <!-- The row counts the shelf, which is what this
                                                 page is for. Everything else about a product —
                                                 its price, its photo, its barcode — lives one
                                                 press away, because until now the only way to
                                                 reach it was to wait for the thing to run low
                                                 and open it from the dashboard. -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <Button Style="{StaticResource Button.RowAction}"
                                                        Click="Edit_Click" Tag="{Binding Id}"
                                                        ToolTip="Edit this product — price, photo, barcode">
                                                    <Path Style="{StaticResource Icon.Small}"
                                                          Data="{StaticResource Icon.Edit}"/>
                                                </Button>

                                                <!-- Takes the product off the shelf. Not a
                                                     delete: last year's receipts point at this
                                                     row and have to keep resolving, so it is
                                                     hidden rather than destroyed and the button
                                                     turns into the one that puts it back. -->
                                                <Button x:Name="removeButton"
                                                        Style="{StaticResource Button.RowDanger}"
                                                        Margin="4,0,0,0"
                                                        Click="Remove_Click" Tag="{Binding Id}"
                                                        ToolTip="Remove this product from the shop">
                                                    <Path x:Name="removeGlyph"
                                                          Style="{StaticResource Icon.Small}"
                                                          Data="{StaticResource Icon.Trash}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <DataTemplate.Triggers>
                                        <!-- An empty shelf is the one thing a stock list has to
                                             say out loud; everything else is just a number. -->
                                        <DataTrigger Binding="{Binding Status}" Value="OutOfStock">
                                            <Setter TargetName="onHand" Property="Foreground"
                                                    Value="{StaticResource Brush.Muted}"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ExpiryNeedsAttention}" Value="True">
                                            <Setter TargetName="expiry" Property="Foreground"
                                                    Value="{StaticResource Brush.Danger}"/>
                                            <Setter TargetName="expiry" Property="FontWeight"
                                                    Value="SemiBold"/>
                                        </DataTrigger>

                                        <!-- A removed product reads as retired rather than as
                                             one more thing on the shelf, and its one remaining
                                             action is to come back. -->
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter TargetName="row" Property="Opacity" Value="0.55"/>
                                            <Setter TargetName="removedTag" Property="Visibility"
                                                    Value="Visible"/>
                                            <Setter TargetName="removeGlyph" Property="Data"
                                                    Value="{StaticResource Icon.Undo}"/>
                                            <Setter TargetName="removeButton" Property="Foreground"
                                                    Value="{StaticResource Brush.Muted}"/>
                                            <Setter TargetName="removeButton" Property="ToolTip"
                                                    Value="Put this product back in the shop"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="Empty" Style="{StaticResource Panel.Empty}" Visibility="Collapsed">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Nav.Inventory}"
                                  Width="30" Height="30" StrokeThickness="1.4"
                                  Stroke="{StaticResource Brush.Muted}"/>
                            <TextBlock x:Name="EmptyTitle" Style="{StaticResource Text.EmptyTitle}"/>
                            <TextBlock x:Name="EmptyBody" Style="{StaticResource Text.EmptyBody}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</local:AdminPageBase>
