<local:AdminPageBase x:Class="MarketPos.Views.Admin.ActivityPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:MarketPos.Views.Admin">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== Search and what to show ==================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Brush.Card}" CornerRadius="10" Height="36">
                <Grid>
                    <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Search}"
                          Width="13" Height="13" HorizontalAlignment="Left" Margin="13,0,0,0"
                          Stroke="{StaticResource Brush.Muted}"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Plain}" Height="36"
                             Background="Transparent" BorderThickness="0" Margin="33,0,10,0"
                             VerticalContentAlignment="Center" FontSize="13"
                             CaretBrush="{StaticResource Brush.Text}" TextChanged="Filter_Changed"/>
                    <TextBlock Text="Who, or what they touched" Style="{StaticResource Text.Muted}"
                               Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox,
                                            Converter={StaticResource InvStrVis}}"/>
                </Grid>
            </Border>

            <ComboBox x:Name="KindFilter" Grid.Column="1" Style="{StaticResource ComboBox.Form}"
                      Width="180" Height="36" Margin="10,0,0,0"
                      SelectionChanged="Filter_Changed"/>

            <TextBlock x:Name="Summary" Grid.Column="2" Style="{StaticResource Text.Muted}"
                       VerticalAlignment="Center" Margin="16,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- ==================== What happened ==================== -->
        <Border Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource Brush.Card}"
                CornerRadius="16" Padding="10,14,10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="Rows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,0" Height="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="10"
                                            Background="{StaticResource Brush.Panel}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initial}" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Muted}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,16,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Sentence}"
                                                   Style="{StaticResource Text.Cell}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Kind}"
                                                   Style="{StaticResource Text.Muted}"
                                                   FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding When}"
                                               Style="{StaticResource Text.CellMuted}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="Empty" Style="{StaticResource Panel.Empty}" Visibility="Collapsed">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Nav.Activity}"
                              Width="30" Height="30" StrokeThickness="1.4"
                              Stroke="{StaticResource Brush.Muted}"/>
                        <TextBlock x:Name="EmptyTitle" Style="{StaticResource Text.EmptyTitle}"/>
                        <TextBlock x:Name="EmptyBody" Style="{StaticResource Text.EmptyBody}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</local:AdminPageBase>
