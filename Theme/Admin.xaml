<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===================== Back-office styles =====================
         Everything here is built from the tokens already in Theme.xaml — the same palette,
         the same 0:0:0.15 easing, the same corner radii and the same Segoe UI stack. No new
         colours are introduced: a status pill is Accent, Danger or Muted, and a table row is
         the existing Brush.Card. The dashboard is meant to read as the same product as the
         till, seen from the office rather than the counter. -->

    <!-- ===================== Type ===================== -->

    <!-- The one large-number style. Financial figures are the reason this screen exists,
         so they are set larger than anything else on the page. -->
    <!-- The headline figure. Set in the brand face, because on most pages it is the largest
         thing on screen and therefore the thing that says whose product this is. Tabular, so
         two figures side by side are honestly comparable. -->
    <Style x:Key="Text.Stat" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Brand}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Stat}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="Typography.NumeralStyle" Value="Lining"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Text.StatSmall" TargetType="TextBlock" BasedOn="{StaticResource Text.Stat}">
        <Setter Property="FontSize" Value="19"/>
    </Style>

    <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style x:Key="Text.Cell" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Text.CellMuted" TargetType="TextBlock" BasedOn="{StaticResource Text.Cell}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
    </Style>

    <!-- Money lines up only if the digits do. Tabular figures keep a column of totals
         readable without switching to a monospace face that would fight the brand. -->
    <!-- Right-aligned and tabular, so the decimal points stack down a column and two totals
         of the same value are the same width. Proportional digits made a column of prices
         look ragged and made similar figures look unlike each other, which is precisely the
         comparison somebody reading down the column is trying to make. -->
    <Style x:Key="Text.Money" TargetType="TextBlock" BasedOn="{StaticResource Text.Cell}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="Typography.NumeralStyle" Value="Lining"/>
    </Style>

    <Style x:Key="Text.ColumnHead" TargetType="TextBlock" BasedOn="{StaticResource Text.Eyebrow}">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== Layout blocks ===================== -->

    <Style x:Key="Card.Stat" TargetType="Border" BasedOn="{StaticResource Card.Panel}">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="MinWidth" Value="150"/>
    </Style>

    <Style x:Key="Card.Section" TargetType="Border" BasedOn="{StaticResource Card.Panel}">
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="Card.Inner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <!-- Thin rule between table rows. Border, not a Rectangle, so it inherits the card radius. -->
    <Style x:Key="Rule" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Brush.Border}"/>
    </Style>

    <!-- ===================== Sidebar navigation ===================== -->

    <!-- The rail from the till, widened to carry a label. Same accent-soft hover overlay and
         same 10px radius, so moving between the two windows does not feel like two products. -->
    <!-- The page you are on is drawn solid, every other page outlined. The two styles below
         are what swap them; a control template could not, because the icons sit in the
         button's content rather than in its template. -->
    <Style x:Key="Icon.NavOutline" TargetType="Path" BasedOn="{StaticResource Icon.Small}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                         Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Icon.NavSolid" TargetType="Path" BasedOn="{StaticResource Icon.Small}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Nav" TargetType="RadioButton">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="overlay" CornerRadius="10"
                                Background="{StaticResource Brush.AccentSoft}" Opacity="0"/>

                        <!-- A bar down the left edge of the page you are on. The green fill
                             and the green text both say the same thing in the one channel a
                             colour-blind cashier cannot read; the bar says it in shape. -->
                        <Border x:Name="marker" Width="3" CornerRadius="2"
                                HorizontalAlignment="Left" Margin="0,9"
                                Background="{StaticResource Brush.Accent}" Opacity="0"/>

                        <ContentPresenter Margin="12,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="overlay" Property="Opacity" Value="1"/>
                            <Setter TargetName="marker" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="overlay"
                                                         Storyboard.TargetProperty="Opacity" To="0.75"
                                                         Duration="{StaticResource Anim.Fast}"
                                                         EasingFunction="{StaticResource Ease.Out}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="overlay"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{StaticResource Anim.Fast}"
                                                         EasingFunction="{StaticResource Ease.Out}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="overlay" Property="Opacity" Value="1"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Buttons ===================== -->

    <!-- Small toolbar button: a Pill at table scale. Used for Add / Export / Filter rows. -->
    <Style x:Key="Button.Small" TargetType="Button" BasedOn="{StaticResource Button.Pill}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="Button.SmallMuted" TargetType="Button" BasedOn="{StaticResource Button.PillMuted}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- A borderless icon button for row actions (edit, delete). Deliberately quiet: these
         sit on every row and would shout if they were pills. -->
    <Style x:Key="Button.RowAction" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="8" Background="{StaticResource Brush.Card}" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.RowDanger" TargetType="Button" BasedOn="{StaticResource Button.RowAction}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
    </Style>

    <!-- Whole-row click target for a table. Flat until hovered, exactly like the ticket rows
         the till already uses. -->
    <Style x:Key="Button.Row" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- CardHover, not Card: these rows sit inside a Card-coloured panel,
                             so fading in Card meant hovering a clickable row did nothing at all. -->
                        <Border x:Name="bd" CornerRadius="10" Background="{StaticResource Brush.CardHover}" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{StaticResource Anim.Fast}"
                                                         EasingFunction="{StaticResource Ease.Out}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bd"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{StaticResource Anim.Fast}"
                                                         EasingFunction="{StaticResource Ease.Out}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A tile in a grid, for the places the back office shows things rather than rows —
         categories being the first. Sits on the page ground as a card and lifts on hover,
         where Button.Row fades a card in behind text that is already on one. -->
    <Style x:Key="Button.Card" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="16,15"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="14" Background="{StaticResource Brush.Card}"
                            BorderThickness="1.4" BorderBrush="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Date-range chooser. A ToggleButton pill, same shape as the till's category filters. -->
    <Style x:Key="Button.DateChip" TargetType="ToggleButton" BasedOn="{StaticResource Button.TogglePill}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>

    <!-- ===================== Inputs ===================== -->

    <!-- A field is card-coloured, so on a card-coloured panel it disappears entirely: the
         Record a delivery dialog had three boxes nobody could see. The hairline is what makes
         it an input on any ground, and matches the shell's own border-not-shadow language. -->
    <Style x:Key="TextBox.Field" TargetType="TextBox" BasedOn="{StaticResource TextBox.Plain}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextBox.Multiline" TargetType="TextBox" BasedOn="{StaticResource TextBox.Field}">
        <Setter Property="Height" Value="76"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>

    <Style x:Key="Text.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Eyebrow}">
        <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>

    <!-- Every drop-down in the back office lists something with a Name. Set as ItemTemplate
         rather than DisplayMemberPath: a re-templated ComboBox does not honour
         DisplayMemberPath in its closed box, and printed the item's type name instead. -->
    <DataTemplate x:Key="Combo.Name">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>

    <Style x:Key="ComboBox.Form" TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Field}">
        <Setter Property="Height" Value="40"/>
        <!-- Back-office forms get typed into. The till's own controls stay unfocusable, so the
             barcode scanner never loses the caret; that rule does not apply over here. -->
        <Setter Property="Focusable" Value="True"/>
    </Style>

    <!-- The stock DatePicker is Aero grey-blue with a watermark and a raised calendar button —
         the one control on screen that was not ours. Templated in full so it reads as another
         field: card fill, 12px radius, and a line icon for the calendar. -->
    <Style x:Key="DatePicker.Field" TargetType="DatePicker">
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Base}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="PART_Root" Background="{StaticResource Brush.Card}" CornerRadius="12"
                            BorderThickness="1" BorderBrush="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               VerticalContentAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"/>

                            <ToggleButton x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                          Width="38" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path x:Name="glyph" Style="{StaticResource Icon.Small}"
                                                  Data="{StaticResource Icon.Calendar}" Width="15" Height="15"
                                                  Stroke="{StaticResource Brush.Muted}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="glyph" Property="Stroke"
                                                        Value="{StaticResource Brush.Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Fade"/>

                            <Grid x:Name="PART_DisabledVisual" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush"
                                    Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The inner text box: no watermark, no border, our padding. -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Border Background="Transparent" Padding="13,0,0,0">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The calendar in the drop-down, in the brand's own colours. -->
    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Base}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>

    <Style TargetType="CalendarDayButton">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="bd" CornerRadius="8" Background="Transparent" Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Card}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.AccentDark}"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Check.Field" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Base}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="box" Width="20" Height="20" CornerRadius="6"
                                Background="{StaticResource Brush.Card}" BorderThickness="1"
                                BorderBrush="{StaticResource Brush.Border}" VerticalAlignment="Center">
                            <Path x:Name="tick" Data="{StaticResource Icon.Check}" Stretch="Uniform"
                                  Width="12" Height="12" Opacity="0" StrokeThickness="2.6"
                                  Stroke="{StaticResource Brush.Panel}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="tick" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Status pills ===================== -->

    <!-- Three states, three existing colours. Green for fine, red for wrong, grey for
         nothing-to-say — no new hues and nothing that needs a legend. -->
    <Style x:Key="Badge.Ok" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.AccentDark}"/>
        <Setter Property="TextElement.FontSize" Value="11"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Badge.Bad" TargetType="Border" BasedOn="{StaticResource Badge.Ok}">
        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Danger}"/>
    </Style>

    <Style x:Key="Badge.Neutral" TargetType="Border" BasedOn="{StaticResource Badge.Ok}">
        <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Muted}"/>
    </Style>

    <!-- ===================== Empty state ===================== -->

    <Style x:Key="Panel.Empty" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,50"/>
    </Style>

    <Style x:Key="Text.EmptyTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>

    <Style x:Key="Text.EmptyBody" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="330"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

</ResourceDictionary>
