# Build output. Everything here is regenerated by `dotnet build`.
bin/
obj/

# Published builds. The exe is 72MB; it belongs on a GitHub release, not in the history —
# git keeps every version of a binary for ever, and a handful of builds would make the repo
# larger than the shop will ever be.
dist/

# Visual Studio and Rider leavings.
.vs/
.idea/
*.user
*.suo

# Diagnostics. --icons writes screenshots of every screen; useful to look at, not to keep.
*.png.tmp
icons*.png
untranslated.txt

# The shop's own data never lives in the repo. It sits in %AppData%\MarketPos — the database,
# the settings, the product photos. Listed here so nobody is tempted to copy one in for
# testing and commit a real shop's takings.
*.db
*.db-shm
*.db-wal
settings.json
crash.log
