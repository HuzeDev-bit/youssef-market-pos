<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MarketPos</RootNamespace>
    <AssemblyName>MarketPos</AssemblyName>

    <!-- One file means one file.

         PublishSingleFile on its own leaves every native library loose beside the exe —
         wpfgfx_cor3.dll and PresentationNative_cor3.dll for the window, e_sqlite3.dll for the
         database. The shop is handed the exe and nothing else, and without these it cannot
         open a window or a database: WPF throws DllNotFoundException before anything is on
         screen, and SQLite throws out of a type initializer. Both look like the program
         closing itself the moment it is opened.

         This is what puts them inside the file. They are unpacked to a temp folder on first
         run, which is why that run is the slow one. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- The cashier's download is this same program built under a different name, which is how
         a copy knows it is a till and leaves the serving to the shop's server — see
         App.OnStartup. Built with -p:TillBuild=true. A property rather than -p:AssemblyName,
         because that one flows down into the Core project as well and both halves then try to
         publish a file of the same name. -->
    <AssemblyName Condition="'$(TillBuild)' == 'true'">MarketPosTill</AssemblyName>

    <!-- And the role is compiled in, not read back off the file name at run time.
         Windows renames a second download to "MarketPosTill (1).exe", which does not end in
         Till — so the copy the shop actually double-clicks stopped being a till and became a
         shop of its own, with its own database, silently. A build knows what it is. -->
    <DefineConstants Condition="'$(TillBuild)' == 'true'">$(DefineConstants);TILL_BUILD</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <!-- What the shop sees in Explorer, on the taskbar and in the title bar. Without
         it the exe wears the generic .NET icon, which is the first thing a client
         looks at. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled into the exe, so the app stays a single self-contained drop with no
         loose image files for the client to accidentally move or delete. -->
    <Resource Include="Assets\logo.png" />

    <!-- The brand's own type, compiled in. A shop machine has whatever fonts Windows shipped
         with and nothing else, so a family named but not embedded would silently fall back to
         Segoe UI and the whole identity with it. -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- The other projects live under this one on disk, and the SDK compiles everything
         beneath a project folder by default - which pulled Core's sources into the app a
         second time and produced duplicate-attribute errors nobody would guess the cause of. -->
    <Compile Remove="src\**;server\**;launcher\**" />
    <None Remove="src\**;server\**;launcher\**" />
    <Page Remove="src\**;server\**;launcher\**" />
    <EmbeddedResource Remove="src\**;server\**;launcher\**" />
    <Resource Remove="src\**;server\**;launcher\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shop's rules live in Core, with no screen attached, so the server can enforce the
         same ones. SQLite comes in through it rather than being referenced twice. -->
    <ProjectReference Include="src\MarketPos.Core.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
